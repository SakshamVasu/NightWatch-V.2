{
  "name": "night-watch",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Parse and analyze raw Nmap scan output into a professional security dashboard — entirely in the browser.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --import ./scripts/register-loader.mjs --test src/parser/__tests__/*.test.ts",
    "parse": "node --experimental-strip-types --import ./scripts/register-loader.mjs scripts/runtest.mts",
    "build:standalone": "node scripts/build-standalone.mjs"
  },
  "dependencies": {
    "lucide-react": "^0.454.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  }
}
